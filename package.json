{
  "name": "radius-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based postal locality radius search with maps and attributed CSV/JSON/GeoJSON exports.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs dist",
    "build": "node scripts/build.mjs",
    "build:full": "node scripts/refresh-data.mjs && node scripts/build.mjs",
    "data:refresh": "node scripts/refresh-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  }
}
